    "dompurify": "^3.3.1",
    "framer-motion": "^12.40.0",
    "html2canvas": "^1.4.1",
    "jose": "^5.9.6",
    "jspdf": "^2.5.1",
    "katex": "^0.16.27",
    "lucide-react": "^0.562.0",
    "mermaid": "^11.12.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet-async": "^2.0.5",
